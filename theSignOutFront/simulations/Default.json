{
  "name" : "Default",
  "steps" : [ {
    "type" : "print",
    "value" : "Simulation Start"
  }, {
    "type" : "spawn",
    "count" : "answers.childs-on-campus",
    "as" : "students"
  }, {
    "type" : "precompute-driveway"
  }, {
    "type" : "for",
    "var" : "tick",
    "from" : 0,
    "to" : 86400,
    "step" : "answers.rate-of-advancement",
    "steps" : [ {
      "type" : "print",
      "value" : "tick"
    }, {
      "type" : "for-each",
      "collection" : "students",
      "as" : "student",
      "steps" : [ {
        "type" : "if",
        "condition" : {
          "and" : [ {
            "=" : [ "student.onDriveway", false ]
          }, {
            "=" : [ "student.position", 0 ]
          }, {
            "ge" : [ "tick", {
              "op" : "ADD",
              "args" : [ {
                "op" : "MULTIPLY",
                "args" : [ "student.arrivalHour", 3600 ]
              }, {
                "op" : "MULTIPLY",
                "args" : [ "student.arrivalMinute", 60 ]
              } ]
            } ]
          } ]
        },
        "then" : [ {
          "type" : "set",
          "target" : "student.onDriveway",
          "value" : true
        }, {
          "type" : "record-slide-view"
        } ]
      }, {
        "type" : "if",
        "condition" : {
          "=" : [ "student.onDriveway", true ]
        },
        "then" : [ {
          "type" : "set",
          "target" : "student.position",
          "value" : {
            "op" : "ADD",
            "args" : [ "student.position", {
              "op" : "MULTIPLY",
              "args" : [ {
                "op" : "DIVIDE",
                "args" : [ {
                  "op" : "DRIVEWAY_SPEED",
                  "args" : [ "student.position" ]
                }, 3600 ]
              }, "answers.rate-of-advancement" ]
            } ]
          }
        }, {
          "type" : "if",
          "condition" : {
            "ge" : [ "student.position", "answers.long-is-driveway" ]
          },
          "then" : [ {
            "type" : "set",
            "target" : "student.onDriveway",
            "value" : false
          } ]
        } ]
      } ]
    } ]
  }, {
    "type" : "slide-report"
  }, {
    "type" : "print",
    "value" : "Simulation complete!"
  } ],
