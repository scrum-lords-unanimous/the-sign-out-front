{
  "steps": [
    {"type":  "print", "value":  "Simulation Start"},
    {
      "type": "spawn",
      "count": "answers.childs-on-campus",
      "as": "students"
    },
    {
      "type": "for",
      "var": "tick",
      "from": 0,
      "to": 86400,
      "steps": [
        {"type": "print", "value":  "tick"},
        {
          "type": "for-each",
          "collection": "students",
          "as": "student",
          "steps": [
            {
              "type": "if",
              "condition": {"and": [
                {"=": ["student.onDriveway", false]},
                {"=": ["student.position", 0]},
                {"=": ["tick.hour", "student.arrivalHour"]},
                {"=": ["tick.minute", "student.arrivalMinute"]}
              ]},
              "then": [
                {"type": "set", "target": "student.onDriveway", "value": true}
              ]
            },
            {
              "type": "if",
              "condition": {"=": ["student.onDriveway", true]},
              "then": [
                {
                  "type": "set",
                  "target": "student.position",
                  "value": {"op": "ADD", "args": [
                    "student.position",
                    {"op": "DIVIDE", "args": ["student.props.safe-curve-speed", 3600]}
                  ]}
                },
                {
                  "type": "if",
                  "condition": {"ge": ["student.position", "answers.long-is-driveway"]},
                  "then": [
                    {"type": "set", "target": "student.onDriveway", "value": false}
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {"type": "print", "value": "Simulation complete!"}
  ]
}
